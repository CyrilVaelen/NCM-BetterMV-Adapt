{
  "manifest_version": 1,
  "name": "BetterMV（增强定制版）",
  "slug": "ncm-better-mv",
  "version": "0.9.0-local-export.45",
  "author": "CyrilVaelen",
  "author_link": "https://github.com/CyrilVaelen/NCM-BetterMV-Reproduce",
  "description": "为正在播放的歌曲实时生成 3D MV：内置 41 个实时动效场景、5 种曲风导演风格、4 种胶片印刷画风，支持全场景主旋律响应、秒开秒切着色器缓存加速与本地视频导出。",
  "betterncm_version": ">=1.3.4",
  "ncm-version-req": ">=3.0.0",
  "ncm3-compatible": true,
  "type": "extension",
  "require_restart": true,
  "preview": "preview.jpg",
  "injects": {
    "Main": [
      {
        "file": "bettermv.js"
      }
    ]
  }
}
