{
  "name": "ncm-better-mv",
  "version": "0.9.0-local-export.115",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "eval": "bun tools/eval-analysis.ts",
    "plugin": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-plugin.ps1",
    "pack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pack-plugin.ps1",
    "export:serve": "node exporter/server.mjs",
    "export:build": "node exporter/build-plugin.mjs",
    "export:test": "node --test exporter/server.test.mjs exporter/camera-continuity.test.mjs exporter/empirical-m1-transition.mjs exporter/empirical-m1-looks.mjs exporter/empirical-m2-scenes.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "26.6.5",
    "@types/three": "^0.186.0",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "jszip": "3.10.1",
    "playwright-core": "1.64.1",
    "vite": "8.3.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
